{
  "name": "howsheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "누구나 만드는 단일 페이지 단계별 해결 가이드",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.20.0 <25.0.0",
    "pnpm": ">=11.5.3"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "node scripts/check-node.mjs && vite",
    "build": "node scripts/check-node.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project dom",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs"
  },
  "dependencies": {
    "dexie": "4.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "7.18.3",
    "zod": "4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
